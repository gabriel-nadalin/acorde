# Copy to `.env` and adjust. Read by docker-compose.yml.

# --- Required -------------------------------------------------------------
# PocketBase superuser, created/updated automatically on first start.
# docker-compose.yml has NO fallback for this one: `docker compose up` (and
# `docker compose config`) refuses to start until it is set, so the template
# password below can never end up in a running deployment.
PB_ADMIN_PASSWORD=change-me-before-exposing

# --- Optional -------------------------------------------------------------
PB_ADMIN_EMAIL=admin@example.com

# Backend URL baked into the Flutter web bundle at build time.
# Leave it EMPTY (the default) for the shipped deployment: nginx proxies /api/
# to the `pocketbase` service, so the app is same-origin and needs no absolute
# URL. For web this value is resolved by the BROWSER, so a non-empty value must
# be reachable from the client machine -- not from inside the app container.
PB_URL=

# Public URL the app is served at (the nginx/front-end origin, NOT the backend
# port). PocketBase puts it in the password-reset email, so it must be the URL
# the RECIPIENT's browser can open: the link is built as
# `<PB_APP_URL>/#/reset-password?token=...`. Left empty, PocketBase keeps
# whatever appURL is stored in its settings, and its default
# (http://localhost:8090) points at the backend -- a link that goes nowhere.
PB_APP_URL=

# --- Demo / prototype switches (optional) ---------------------------------
# Guest sign-in: adds an "Entrar como visitante" button to the sign-in screen,
# which creates a throwaway account (generated address at the reserved
# `guest.invalid` domain, generated password) and signs in with it. Meant for
# demos, where asking a reviewer for an address and password to look at a
# prototype is friction with no payoff.
#
# ON by default, because this is a prototype and the button has to exist in a
# demo that nobody configured. It is therefore an OFF switch: set it to 0 (or
# false/off/no) to remove the button, which a deployment with real users should
# do, since guest accounts have no verified address. Any other value -- including
# unset, empty, or a typo -- leaves it on.
#
# The client asks `GET /api/agenda/guest-status` and draws the button only when
# the answer is yes, so flipping this off removes the button too. No rebuild.
#
# A guest is an ordinary account created through the normal public signup
# endpoint: no elevated rights, subject to the same rules and rate limits.
PB_GUEST_LOGIN=

# --- Outbound mail (optional) ---------------------------------------------
# With these set, the app sends two messages by itself:
#   * an invitation, to the address a manager invites;
#   * a "somebody asked to join" notice, to the managers of that entity.
# Without them, membership is in-app only: an invited person is never told, and a
# request is visible only to a manager who happens to open their dashboard. That
# is the whole reason to configure this.
#
# Once set, the values are written into PocketBase's settings on boot and STAY
# there: unsetting them leaves the stored configuration alone, so the dashboard
# remains a valid way to configure mail by hand. To switch mail OFF you must clear
# it in the dashboard (Settings -> Mail settings), not just remove these lines.
#
# PB_SMTP_HOST unset but a password set is ignored rather than half-applied: a
# host with no password would send nothing, and `GET /api/agenda/mail-status`
# would then report a working mailer to the reset form.
#
# PB_SMTP_FROM defaults to PB_SMTP_USERNAME, which is what most relays want.
#
# PB_SMTP_TLS selects how the connection is secured, and the two modes are not
# interchangeable: 0 sends STARTTLS (upgrade after connecting — port 587, the
# standard submission port, and the default here), while 1 means IMPLICIT TLS
# (encrypted from the first byte — port 465). Choosing the wrong one fails with
# "first record does not look like a TLS handshake", which reads like a broken
# mail server rather than a mismatched setting.
PB_SMTP_HOST=
PB_SMTP_PORT=587
PB_SMTP_USERNAME=
PB_SMTP_PASSWORD=
PB_SMTP_FROM=
PB_SMTP_SENDER_NAME=Event Calendar
PB_SMTP_TLS=0
