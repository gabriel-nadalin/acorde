# Copy to `.env` and adjust. Read by docker-compose.yml.

# PocketBase superuser, created/updated automatically on first start.
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me-before-exposing

# Backend URL baked into the Flutter web bundle at build time.
# For Flutter web this is resolved by the BROWSER, so it must be reachable
# from the client machine — not from inside the app container.
PB_URL=http://127.0.0.1:8090
