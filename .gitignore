# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Generated localization output: `flutter gen-l10n` writes these next to the
# ARB files (lib/l10n is the output-dir in l10n.yaml). They are build products,
# regenerated on every build/test -- committing them only creates merge noise
# and stale-key confusion next to the frozen ARBs.
lib/l10n/app_localizations*.dart

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# PocketBase runtime state — never commit: holds the SQLite DB (including the
# _superusers credentials) and uploaded files.
/pb_data/
/pb_public/

# Throwaway data/hooks dirs. scripts/guard_test.dart and scripts/verify_schema.dart
# run the backend against a fresh directory under the OS temp dir, so these
# belong to local one-off runs that pointed PB_TEST_DATA_DIR at the repo. They
# must never be committed: they hold a SQLite DB and superuser credentials.
*.pb_data_tmp/
*.pb_hooks_tmp/

# PocketBase binaries and local auth cookies
/pocketbase
/pocketbase.zip
.pb_cookie
cookie.txt

# Local environment overrides (see .env.example)
.env
.env.local
